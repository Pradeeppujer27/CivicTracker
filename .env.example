# ==============================================================
# CivicTrack - Environment Configuration Template (.env.example)
# Copy this file to .env and supply actual production credentials.
# DO NOT commit real secrets or production passwords to version control!
# ==============================================================

# Server Runtime Settings
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Production MySQL Database Settings (Aiven / PlanetScale / Railway / Render / AWS RDS)
# Format: jdbc:mysql://<HOST>:<PORT>/<DATABASE>?sslMode=REQUIRED&serverTimezone=UTC
SPRING_DATASOURCE_URL=jdbc:mysql://mysql-instance.example.com:3306/civictrack?useSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=civictrack_user
SPRING_DATASOURCE_PASSWORD=YourStrongDatabasePassword123!

# JPA Hibernate Mode (update or validate in production)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# 256-bit Hex JWT Secret for HS256 (64 hex characters)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_super_secret_256_bit_jwt_key_should_be_at_least_64_characters_long
JWT_EXPIRATION_MS=86400000

# Persistent Evidence Upload Directory (Mount persistent disk here)
UPLOAD_DIR=/var/data/uploads

# CORS Allowed Origins (Comma-separated list or wildcard)
CORS_ALLOWED_ORIGINS=https://civictrack.vercel.app,https://civictrack.netlify.app,https://civictrack-backend.onrender.com

# Frontend API Configuration (Set on Vercel / Netlify environment variables)
# CIVICTRACK_API_BASE=https://civictrack-backend.onrender.com/api/v1
